# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=phadai

# JWT Configuration
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini API Configuration
# Get your API key from: https://ai.google.dev/tutorials/setup
GEMINI_API_KEY=

# Google OAuth Configuration
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Razorpay (India-first billing). Use test-mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs created in the Razorpay dashboard (Subscriptions -> Plans)
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PREMIUM_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_PREMIUM_YEARLY=
RZP_TEST_MODE=true
